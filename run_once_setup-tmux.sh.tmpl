#!/bin/bash
# Install TPM and tmux plugins
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

TPM_DIR="$HOME/.tmux/plugins/tpm"

if [ ! -d "$TPM_DIR" ]; then
    git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi

# Install plugins non-interactively
"$TPM_DIR/bin/install_plugins"
{{ end -}}
